# Server Configuration
PORT=5000
NODE_ENV=development

# Boutique Owner Email (Recipient for all customer enquiries)
OWNER_EMAIL=owner@suisaajboutique.com

# SMTP Configuration (e.g., Gmail App Password, Zoho, Brevo, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM_NAME=SuiSaaj Boutique Enquiries
SMTP_FROM_EMAIL=your-smtp-email@gmail.com

# Optional: Set to true only for local offline testing without live SMTP credentials
# Uses Nodemailer JSON/stream transport so submissions succeed locally without sending real email
SMTP_MOCK=false

# Frontend Configurable Business Details (Vite public env vars - never put secrets here!)
VITE_BOUTIQUE_NAME=SuiSaaj
VITE_BOUTIQUE_TAGLINE=Ladies Boutique & Bespoke Tailoring
VITE_PHONE_DISPLAY=+91 98765 43210
VITE_PHONE_RAW=+919876543210
VITE_WHATSAPP_NUMBER=919876543210
VITE_INSTAGRAM_URL=https://www.instagram.com/suisaajboutique/
VITE_BOUTIQUE_ADDRESS=24 Roseview Lane, Hauz Khas Enclave, New Delhi 110016
VITE_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps?q=Hauz+Khas+New+Delhi&output=embed
VITE_GOOGLE_MAPS_LINK=https://maps.google.com/?q=Hauz+Khas+New+Delhi
